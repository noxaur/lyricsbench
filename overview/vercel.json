{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node build-all.mjs",
  "outputDirectory": "dist",
  "installCommand": "node install-all.mjs",
  "rewrites": [
    {
      "source": "/benches/:slug/api/:path*",
      "destination": "/api/bench?slug=:slug&path=api/:path*"
    },
    {
      "source": "/benches/:slug",
      "destination": "/api/bench?slug=:slug"
    },
    {
      "source": "/benches/:slug/:path*",
      "destination": "/api/bench?slug=:slug&path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/bench.js": {
      "includeFiles": "{api/**,bench-adapt.mjs,dist/benches/**/*.html}",
      "maxDuration": 30
    }
  }
}
