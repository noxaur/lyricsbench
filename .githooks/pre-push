#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(git rev-parse --show-toplevel)/overview"

echo "pre-push · pnpm ci + verify"
pnpm ci
pnpm verify

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "${remote_ref:-}" == "refs/heads/main" ]]; then
    pushing_main=1
  fi
done

if [[ "$pushing_main" == 1 ]]; then
  echo "pre-push · vercel deploy --prod"
  npx vercel deploy --prod --yes --non-interactive
fi
